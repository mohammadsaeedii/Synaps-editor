# Synapse API — environment variables
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000

# PostgreSQL (Neon / Supabase)
DATABASE_URL=postgresql://user:pass@localhost:5432/synapse

# Redis (Upstash)
REDIS_URL=redis://localhost:6379

# Auth
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
ENCRYPTION_KEY=change-me-to-a-random-string-at-least-32-chars

# AI (server-side only — never expose to frontend)
ANTHROPIC_API_KEY=

# Observability (optional)
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
